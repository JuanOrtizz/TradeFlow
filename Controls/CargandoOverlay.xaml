<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TradeFlow.Controls.CargandoOverlay"
             x:Name="root">

    <Grid BackgroundColor="{StaticResource OverlayColor}"
          IsVisible="{Binding EstaCargando, Source={x:Reference root}}">
        <ActivityIndicator Color="DarkCyan"
                           WidthRequest="60"
                           HeightRequest="60"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           IsRunning="{Binding EstaCargando, Source={x:Reference root}}" />
    </Grid>

</ContentView>
