<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TradeFlow.Views.BackupView"
             xmlns:controls="clr-namespace:TradeFlow.Controls"
             Title="Backup"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="*"
          Padding="20">

        <ScrollView IsVisible="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}">
            <VerticalStackLayout Spacing="16">

                <!-- Datos -->
                <Border Style="{StaticResource CardStyle}" Padding="20">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Respaldo de datos"
                               Style="{StaticResource SectionTitleStyle}" />

                        <BoxView HeightRequest="1" Color="Black" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="Crear Backup:"
                                   FontAttributes="Bold"
                                   TextColor="Black" />
                            <Label Grid.Column="1"
                                   Text="Genera una copia de la base de datos en la carpeta Backups."
                                   TextColor="{StaticResource TextPrimary}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="Restaurar:"
                                   FontAttributes="Bold"
                                   TextColor="Black" />
                            <Label Grid.Column="1"
                                   Text="Reemplaza la base actual por el backup seleccionado. Antes se crea un respaldo automático de sus datos."
                                   TextColor="{StaticResource TextPrimary}" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Acciones -->
                <Button Text="Crear Backup"
                        Command="{Binding CrearBackupCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                        Margin="0,8,0,0" />

                <Button Text="Restaurar Backup"
                        Command="{Binding RestaurarBackupCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        BackgroundColor="DarkGoldenrod"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}" />

            </VerticalStackLayout>
        </ScrollView>

        <controls:CargandoOverlay EstaCargando="{Binding IsBusy}" />

    </Grid>

</ContentPage>
