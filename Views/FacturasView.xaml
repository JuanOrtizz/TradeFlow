<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:TradeFlow.Helpers"
             x:Class="TradeFlow.Views.FacturasView"
             xmlns:controls="clr-namespace:TradeFlow.Controls"
             Title="Facturas"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="20">

        <!-- SearchBar + boton crear -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <Border
                StrokeShape="4"
                Stroke="LightGray"
                StrokeThickness="{StaticResource BorderColor}"
                >

                <Border.Triggers>
                    <DataTrigger TargetType="Border"
                     Binding="{Binding Source={x:Reference BarraBusqueda}, Path=IsFocused}"
                     Value="True">
                        <Setter Property="Stroke" Value="DarkCyan" />
                    </DataTrigger>
                </Border.Triggers>


                <SearchBar Grid.Column="0"
                        x:Name="BarraBusqueda"
                        Placeholder="Buscar por número de factura..."
                        Text="{Binding TextoBusqueda}"
                        SearchCommand="{Binding BuscarCommand}"
                        Style="{StaticResource SearchBarStyle}"
                        Margin="0" 
                        CancelButtonColor="Red"
                         />
                
            </Border>

            <Button Grid.Column="1"
                    Text="Crear"
                    Command="{Binding IrAAgregarCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="12"
                    CornerRadius="12"
                    FontSize="16"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
        </Grid>

        <!-- Filtro por fecha -->
        <Grid Grid.Row="1"
              Margin="0,10,0,0"
              ColumnDefinitions="Auto,Auto,Auto,Auto,*"
              ColumnSpacing="8">
            <Label Grid.Column="0"
                   Text="Filtrar por fecha:"
                   FontSize="14"
                   TextColor="{StaticResource TextPrimary}"
                   VerticalOptions="Center" />
            <Border Grid.Column="1"
                    StrokeShape="RoundRectangle 5"
                    StrokeThickness="2"
                    Stroke="{StaticResource BorderColor}"
                    HeightRequest="50"
                    BackgroundColor="{StaticResource CardBackground}"
                    Padding="5,0">
                <Border.Triggers>
                    <DataTrigger TargetType="Border"
                                 Binding="{Binding Source={x:Reference SelectorFecha}, Path=IsFocused}"
                                 Value="True">
                        <Setter Property="Stroke" Value="#00F0FF" />
                    </DataTrigger>
                </Border.Triggers>
                <DatePicker x:Name="SelectorFecha"
                            Date="{Binding FechaSeleccionada}"
                            Format="dd/MM/yyyy"
                            FontSize="16"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource TextPrimary}"
                            DateSelected="OnFechaSeleccionada" />
            </Border>
            <Grid Grid.Column="2" RowDefinitions="Auto,Auto">
                <Button Grid.Row="0"
                        Text="Hoy"
                        Style="{StaticResource TextButtonStyle}"
                        Clicked="OnHoyClicked" />
                <BoxView Grid.Row="1"
                         HeightRequest="2"
                         Color="{StaticResource Primary}"
                         IsVisible="{Binding FiltroHoyActivo}" />
            </Grid>
            <Grid Grid.Column="3" RowDefinitions="Auto,Auto">
                <Button Grid.Row="0"
                        Text="Todas"
                        Style="{StaticResource TextButtonStyle}"
                        Clicked="OnTodasClicked" />
                <BoxView Grid.Row="1"
                         HeightRequest="2"
                         Color="{StaticResource Primary}"
                         IsVisible="{Binding FiltroTodasActivo}" />
            </Grid>
        </Grid>

        <!-- Lista de facturas -->

        <CollectionView 
            Grid.Row="2"
            ItemsSource="{Binding ListaFacturas}"
            IsVisible="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
            Margin="0,8,0,0"
            >

            <CollectionView.EmptyView>
                <Label Text="No hay facturas registradas"
               Style="{StaticResource EmptyStateStyle}"
               Margin="20,40" />
            </CollectionView.EmptyView>

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                   ItemSpacing="5" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border Style="{StaticResource CardStyle}"
                       helpers:HandCursor.IsEnabled="True"
                       Margin="0,0,0,8"
                       Padding="16">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.VerDetalleCommand}"
                              CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid RowDefinitions="Auto,Auto,Auto"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="14"
                              RowSpacing="2">

                            <Label Grid.Row="0" Grid.ColumnSpan="2"
                                Text="{Binding Id, StringFormat='FACTURA #{0}'}"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextPrimary}" />

                            <Label Grid.Row="1" Grid.Column="0"
                                Text="{Binding Cliente.Nombre, Converter={StaticResource TextoVacioConverter}, ConverterParameter='Sin cliente'}"
                                FontSize="14"
                                TextColor="{StaticResource TextSecondary}"
                                LineBreakMode="TailTruncation"
                                VerticalOptions="Center" />

                            <Label Grid.Row="1" Grid.Column="1"
                                Text="{Binding Total, StringFormat='${0:N2}'}"
                                Style="{StaticResource PriceStyle}"
                                VerticalOptions="Center" />

                            <Label Grid.Row="2" Grid.ColumnSpan="2"
                                Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}"
                                FontSize="12"
                                TextColor="{StaticResource TextLight}" />
                        </Grid>
                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <controls:CargandoOverlay EstaCargando="{Binding IsBusy}" />

    </Grid>

</ContentPage>
