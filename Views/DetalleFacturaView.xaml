<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TradeFlow.Views.DetalleFacturaView"
             xmlns:controls="clr-namespace:TradeFlow.Controls"
             Title="Detalle Factura"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="*">

        <ScrollView IsVisible="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}">
            <VerticalStackLayout Padding="20" Spacing="16">

                <Grid
                    RowDefinitions="*"
                    ColumnDefinitions="*, 2*"
                    >
                    <Button 
                        Grid.Column="0"
                        Text="Volver"
                        Style="{StaticResource BackButtonStyle}"
                        Command="{Binding VolverCommand}"
                        />

                    <!-- Botones de accion -->
                        <HorizontalStackLayout
                            Grid.Column="1"
                            HorizontalOptions="End"
                            Spacing="5"
                            >
                            <Button 
                                Text="Imprimir"
                                Command="{Binding IrAImprimirCommand}"
                                Style="{StaticResource OutlineButtonStyle}" />
                            <Button 
                                Text="Eliminar"
                                Command="{Binding EliminarCommand}"
                                Style="{StaticResource DangerButtonStyle}" />
                        </HorizontalStackLayout>

                </Grid>

                <!-- Datos -->
                <Border Style="{StaticResource CardStyle}" Padding="20">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Informacion de la factura"
                               Style="{StaticResource SectionTitleStyle}" />

                        <BoxView HeightRequest="1" Color="Black" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="Numero factura:"
                                   FontAttributes="Bold"
                                   TextColor="Black" />
                            <Label Grid.Column="1" Text="{Binding Factura.Id}"
                                   TextColor="{StaticResource TextPrimary}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="Cliente:"
                                   FontAttributes="Bold"
                                   TextColor="Black" />
                            <Label Grid.Column="1" Text="{Binding Factura.Cliente.Nombre}"
                                   TextColor="{StaticResource TextPrimary}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="Fecha:"
                                   FontAttributes="Bold"
                                   TextColor="Black" />
                            <Label Grid.Column="1" Text="{Binding Factura.Fecha, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                   TextColor="{StaticResource TextPrimary}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="Total:"
                                   FontAttributes="Bold"
                                   TextColor="Black" />
                            <Label Grid.Column="1" Text="{Binding Factura.Total, StringFormat='${0:N2}'}"
                                   TextColor="{StaticResource Success}"
                                   FontAttributes="Bold" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Detalle items -->
                <Label Text="Detalle"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="0,8,0,0" />

                <CollectionView ItemsSource="{Binding Items}">
                    <CollectionView.EmptyView>
                        <Label Text="Sin items en esta factura"
                               Style="{StaticResource EmptyStateStyle}" />
                    </CollectionView.EmptyView>

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical"
                                           ItemSpacing="6" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0"
                                    Padding="14">
                                <Grid ColumnDefinitions="*,Auto"
                                      RowDefinitions="Auto,Auto,Auto,Auto"
                                      RowSpacing="2">
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding ProductoNombre}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}" />
                                    <Label Grid.Row="1" Grid.Column="0"
                                           Text="{Binding Codigo, Converter={StaticResource TextoVacioConverter}, ConverterParameter='Sin Codigo'}"
                                           FontSize="12"
                                           TextColor="{StaticResource TextSecondary}" />
                                    <Label Grid.Row="2" Grid.Column="0"
                                           Text="{Binding CantidadPrecioTexto}"
                                           FontSize="12"
                                           TextColor="{StaticResource TextSecondary}" />
                                    <Label Grid.Row="3" Grid.Column="0"
                                           Text="{Binding DescuentoTexto}"
                                           FontSize="12"
                                           IsVisible="{Binding TieneDescuento}"
                                           TextColor="{StaticResource Danger}" />
                                    <Label Grid.Row="0" Grid.Column="1" Grid.RowSpan="4"
                                           Text="{Binding Subtotal, StringFormat='${0:N2}'}"
                                           Style="{StaticResource PriceStyle}"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <controls:CargandoOverlay EstaCargando="{Binding IsBusy}" />

    </Grid>

</ContentPage>
